# TUNE DMS (desktop GUI automation)
TUNE_USER_ID=your_tune_user_id
TUNE_USER_PASSWORD=your_tune_user_password
# Optional: shortcut path and paths for images/reports
# TUNE_SHORTCUT_PATH=C:\Users\Public\Desktop\TUNE.lnk
# TUNE_IMAGES_DIR=
# TUNE_REPORTS_DIR=


# REVOLUTIONnext SmartCenter – report downloads via API (auto-login, session saved to disk)
REVNEXT_URL=https://yourtenant.revolutionnext.com.au
REVNEXT_USERNAME=your_revnext_username
REVNEXT_PASSWORD=your_revnext_password
# Optional: session cookie file (default: .revnext-session.json in cwd)
# REVNEXT_SESSION_PATH=./.revnext-session.json
# Optional: request timeout in seconds, "30" (read) or "10,120" (connect,read).
# Default 10,120. Every request carries one so a stalled server cannot hang the caller.
# REVNEXT_TIMEOUT=10,120
